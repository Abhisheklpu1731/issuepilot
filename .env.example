ISSUEPILOT_REPO=owner/repo
ISSUES_FILE=data/issues.json
GITHUB_TOKEN=           # needed to post comments/labels after approval
WEBHOOK_SECRET=         # same secret as in the GitHub webhook settings
GROQ_API_KEY=           # optional: LLM-written drafts instead of the template
DRY_RUN=true            # true = approvals are recorded but nothing is posted
SIMILARITY_BACKEND=auto # auto | embeddings | tfidf
